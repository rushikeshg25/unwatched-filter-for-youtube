{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* esbuild does the transpiling; tsc is here purely to check types. */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    /* No Node or Chrome extension APIs are used, so no ambient types. */
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
